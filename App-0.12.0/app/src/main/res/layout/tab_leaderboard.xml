<?xml version="1.0" encoding="utf-8"?>
<!-- Leaderboard tab (ui/LeaderboardTab.kt). On a team it ranks the team's roster; in General use it
     ranks everyone else using the app on their own (who chose to appear there). -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical">

    <TextView
        android:id="@+id/boardTitle"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginStart="16dp"
        android:layout_marginTop="14dp"
        android:layout_marginEnd="16dp"
        android:ellipsize="end"
        android:maxLines="1"
        android:textAppearance="@style/TextAppearance.Lifting.RowTitle" />

    <TextView
        android:id="@+id/boardSubtitle"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginStart="16dp"
        android:layout_marginEnd="16dp"
        android:textAppearance="@style/TextAppearance.Lifting.Caption" />

    <!-- Your follower count. Only you see it; nobody sees who follows whom. -->
    <TextView
        android:id="@+id/followerCountText"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginStart="16dp"
        android:layout_marginTop="6dp"
        android:layout_marginEnd="16dp"
        android:drawablePadding="6dp"
        android:gravity="center_vertical"
        android:textAppearance="@style/TextAppearance.Lifting.Caption"
        app:drawableStartCompat="@drawable/ic_group"
        app:drawableTint="?attr/colorOnSurfaceVariant" />

    <!-- Looks like the other dropdowns; opens the searchable exercise picker -->
    <TextView
        android:id="@+id/boardExerciseField"
        style="@style/Widget.Lifting.Spinner"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginStart="16dp"
        android:layout_marginTop="12dp"
        android:layout_marginEnd="16dp"
        android:clickable="true"
        android:contentDescription="Exercise"
        android:ellipsize="end"
        android:focusable="true"
        android:gravity="center_vertical"
        android:maxLines="1"
        android:textAppearance="@style/TextAppearance.Lifting.BodyLarge"
        android:textColor="?attr/colorOnSurface" />

    <com.google.android.material.button.MaterialButtonToggleGroup
        android:id="@+id/rankToggle"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginStart="16dp"
        android:layout_marginTop="12dp"
        android:layout_marginEnd="16dp"
        app:selectionRequired="true"
        app:singleSelection="true">

        <com.google.android.material.button.MaterialButton
            android:id="@+id/rankEstimatedMax"
            style="@style/Widget.Lifting.SegmentButton"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="Estimated max" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/rankPoundForPound"
            style="@style/Widget.Lifting.SegmentButton"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="Pound-for-pound" />
    </com.google.android.material.button.MaterialButtonToggleGroup>

    <!-- General only: shown while you've turned off "Show me on the General leaderboard" -->
    <TextView
        android:id="@+id/hiddenNotice"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginStart="16dp"
        android:layout_marginTop="10dp"
        android:layout_marginEnd="16dp"
        android:drawablePadding="8dp"
        android:gravity="center_vertical"
        android:text="You're hidden from this leaderboard. Change it in Account &amp; settings → Privacy (tap your profile picture)."
        android:textAppearance="@style/TextAppearance.Lifting.Caption"
        android:visibility="gone"
        app:drawableStartCompat="@drawable/ic_lock"
        app:drawableTint="?attr/colorOnSurfaceVariant" />

    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1">

        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/leaderboardList"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:clipToPadding="false"
            android:paddingStart="12dp"
            android:paddingTop="12dp"
            android:paddingEnd="12dp"
            android:paddingBottom="24dp"
            app:layoutManager="androidx.recyclerview.widget.LinearLayoutManager" />

        <TextView
            android:id="@+id/emptyText"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_margin="16dp"
            android:textAppearance="@style/TextAppearance.Lifting.Muted" />
    </FrameLayout>
</LinearLayout>
