<?xml version="1.0" encoding="utf-8"?>
<!-- Garrett's project4 screen (exerciseSpinner + liftChart + addWeightFab, same ids),
     with an athlete picker added above the chart. -->
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <TextView
        android:id="@+id/athleteLabel"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginStart="16dp"
        android:layout_marginTop="16dp"
        android:text="Athlete"
        android:textColor="@color/bone_muted"
        android:textSize="13sp"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent" />

    <Spinner
        android:id="@+id/athleteSpinner"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="16dp"
        android:popupBackground="@color/grey_surface"
        app:layout_constraintEnd_toStartOf="@id/addAthleteButton"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/athleteLabel" />

    <TextView
        android:id="@+id/noAthletesText"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="16dp"
        android:text="No athletes yet. Add one to start logging."
        android:textColor="@color/bone_muted"
        android:visibility="gone"
        app:layout_constraintBottom_toBottomOf="@id/addAthleteButton"
        app:layout_constraintEnd_toStartOf="@id/addAthleteButton"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="@id/addAthleteButton" />

    <com.google.android.material.button.MaterialButton
        android:id="@+id/addAthleteButton"
        style="@style/Widget.MaterialComponents.Button.TextButton"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginEnd="8dp"
        android:text="+ Add athlete"
        android:textColor="@color/bone"
        app:layout_constraintBottom_toBottomOf="@id/athleteSpinner"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toTopOf="@id/athleteSpinner" />

    <Spinner
        android:id="@+id/exerciseSpinner"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginStart="16dp"
        android:layout_marginTop="16dp"
        android:popupBackground="@color/grey_surface"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/addAthleteButton" />

    <TextView
        android:id="@+id/chartCaption"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginEnd="16dp"
        android:textColor="@color/bone_muted"
        android:textSize="13sp"
        app:layout_constraintBottom_toBottomOf="@id/exerciseSpinner"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toTopOf="@id/exerciseSpinner" />

    <FrameLayout
        android:id="@+id/chartContainer"
        android:layout_width="0dp"
        android:layout_height="300dp"
        android:layout_marginStart="16dp"
        android:layout_marginTop="8dp"
        android:layout_marginEnd="16dp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/exerciseSpinner">

        <com.github.mikephil.charting.charts.LineChart
            android:id="@+id/liftChart"
            android:layout_width="match_parent"
            android:layout_height="match_parent" />

        <com.google.android.material.floatingactionbutton.FloatingActionButton
            android:id="@+id/addWeightFab"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="top|end"
            android:layout_margin="12dp"
            android:contentDescription="Log a set"
            android:src="@android:drawable/ic_input_add"
            app:backgroundTint="@color/bone"
            app:fabSize="mini"
            app:tint="@color/grey_ink" />
    </FrameLayout>

    <TextView
        android:id="@+id/lastSavedText"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_margin="16dp"
        android:textColor="@color/bone_muted"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/chartContainer" />

</androidx.constraintlayout.widget.ConstraintLayout>
