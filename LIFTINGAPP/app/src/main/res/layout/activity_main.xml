<?xml version="1.0" encoding="utf-8"?>
<!-- App shell: tab bar on top, three tab layouts stacked underneath (only one visible at a time).
     fitsSystemWindows keeps content out from under the status bar (targetSdk 36 is edge-to-edge). -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fitsSystemWindows="true"
    android:orientation="vertical"
    tools:context=".MainActivity">

    <com.google.android.material.tabs.TabLayout
        android:id="@+id/tabs"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@android:color/transparent"
        app:tabGravity="fill"
        app:tabIndicatorColor="@color/bone"
        app:tabMode="fixed"
        app:tabSelectedTextColor="@color/bone"
        app:tabTextColor="@color/bone_muted" />

    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1">

        <include
            android:id="@+id/logTab"
            layout="@layout/tab_log" />

        <include
            android:id="@+id/historyTab"
            layout="@layout/tab_history"
            android:visibility="gone" />

        <include
            android:id="@+id/leaderboardTab"
            layout="@layout/tab_leaderboard"
            android:visibility="gone" />
    </FrameLayout>
</LinearLayout>
