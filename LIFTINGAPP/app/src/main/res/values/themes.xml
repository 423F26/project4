<?xml version="1.0" encoding="utf-8"?>
<resources>

    <!-- Dark MaterialComponents base so spinners/inputs draw light-on-dark,
         then the grey wash + bone palette on top. -->
    <style name="Theme.LIFTINGAPP" parent="Theme.MaterialComponents.NoActionBar">
        <item name="android:windowBackground">@drawable/bg_grey_wash</item>
        <item name="android:colorBackground">@color/grey_surface</item>
        <item name="android:statusBarColor">@android:color/transparent</item>
        <item name="android:navigationBarColor">@color/grey_wash_bottom</item>

        <item name="android:textColorPrimary">@color/bone</item>
        <item name="android:textColorSecondary">@color/bone_muted</item>
        <item name="android:textColorHint">@color/bone_muted</item>

        <item name="colorPrimary">@color/bone</item>
        <item name="colorPrimaryVariant">@color/bone_muted</item>
        <item name="colorOnPrimary">@color/grey_ink</item>
        <item name="colorSecondary">@color/bone</item>
        <item name="colorSecondaryVariant">@color/bone_muted</item>
        <item name="colorOnSecondary">@color/grey_ink</item>
        <item name="colorSurface">@color/grey_surface</item>
        <item name="colorOnSurface">@color/bone</item>
        <item name="colorOnBackground">@color/bone</item>
        <item name="colorControlNormal">@color/bone_muted</item>
        <item name="colorControlActivated">@color/bone</item>
    </style>
</resources>
