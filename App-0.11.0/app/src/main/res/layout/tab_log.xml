<?xml version="1.0" encoding="utf-8"?>
<!-- Log tab (ui/LogTab.kt): athlete picker, exercise picker (every exercise from the Workouts tab,
     plus your own), the progress chart card, and the workout log underneath. Log set (bottom right)
     logs one set for the picked athlete and exercise. -->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <androidx.core.widget.NestedScrollView
        android:id="@+id/logScroll"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:clipToPadding="false"
        android:paddingBottom="96dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="16dp">

            <TextView
                android:id="@+id/athleteLabel"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginBottom="6dp"
                android:text="Athlete"
                android:textAppearance="@style/TextAppearance.Lifting.FieldLabel" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <FrameLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1">

                    <Spinner
                        android:id="@+id/athleteSpinner"
                        style="@style/Widget.Lifting.Spinner"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content" />

                    <TextView
                        android:id="@+id/noAthletesText"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_gravity="center_vertical"
                        android:text="No athletes yet. Add one to start logging."
                        android:textAppearance="@style/TextAppearance.Lifting.Muted"
                        android:visibility="gone" />
                </FrameLayout>

                <!-- Edit / delete the picked athlete (only for people who may change them) -->
                <ImageButton
                    android:id="@+id/athleteMenuButton"
                    android:layout_width="40dp"
                    android:layout_height="52dp"
                    android:layout_marginStart="2dp"
                    android:background="?attr/selectableItemBackgroundBorderless"
                    android:contentDescription="Athlete options"
                    android:src="@drawable/ic_more_vert"
                    android:visibility="gone"
                    app:tint="?attr/colorOnSurfaceVariant" />
            </LinearLayout>

            <!-- e.g. "You can add one athlete: yourself." or "Viewing Jordan's progress." -->
            <TextView
                android:id="@+id/athleteHint"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                android:textAppearance="@style/TextAppearance.Lifting.Caption"
                android:visibility="gone" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="14dp"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <!-- Looks like the other dropdowns; opens the searchable exercise picker -->
                <TextView
                    android:id="@+id/exerciseField"
                    style="@style/Widget.Lifting.Spinner"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:clickable="true"
                    android:contentDescription="Exercise"
                    android:ellipsize="end"
                    android:focusable="true"
                    android:gravity="center_vertical"
                    android:maxLines="1"
                    android:textAppearance="@style/TextAppearance.Lifting.BodyLarge"
                    android:textColor="?attr/colorOnSurface" />

                <TextView
                    android:id="@+id/chartCaption"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="16dp"
                    android:layout_marginEnd="4dp"
                    android:textAppearance="@style/TextAppearance.Lifting.Muted" />
            </LinearLayout>

            <!-- Progress card: best max + change, chart, range selector -->
            <com.google.android.material.card.MaterialCardView
                android:id="@+id/chartContainer"
                style="@style/Widget.Lifting.Card"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="14dp"
                app:cardCornerRadius="24dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:paddingStart="16dp"
                    android:paddingTop="16dp"
                    android:paddingEnd="16dp"
                    android:paddingBottom="14dp">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal">

                        <LinearLayout
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:orientation="vertical">

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="Best est. max"
                                android:textAppearance="@style/TextAppearance.Lifting.FieldLabel" />

                            <TextView
                                android:id="@+id/bestMaxText"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="—"
                                android:textAppearance="@style/TextAppearance.Lifting.Stat" />
                        </LinearLayout>

                        <LinearLayout
                            android:id="@+id/changeGroup"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:gravity="end"
                            android:orientation="vertical"
                            android:visibility="invisible">

                            <TextView
                                android:id="@+id/changeLabel"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:textAppearance="@style/TextAppearance.Lifting.FieldLabel" />

                            <TextView
                                android:id="@+id/changeText"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_marginTop="6dp"
                                android:textAppearance="@style/TextAppearance.Lifting.StatSmall" />
                        </LinearLayout>
                    </LinearLayout>

                    <com.github.mikephil.charting.charts.LineChart
                        android:id="@+id/liftChart"
                        android:layout_width="match_parent"
                        android:layout_height="280dp"
                        android:layout_marginTop="8dp" />

                    <com.google.android.material.button.MaterialButtonToggleGroup
                        android:id="@+id/rangeToggle"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="12dp"
                        app:selectionRequired="true"
                        app:singleSelection="true">

                        <com.google.android.material.button.MaterialButton
                            android:id="@+id/range1m"
                            style="@style/Widget.Lifting.SegmentButton"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:text="1M" />

                        <com.google.android.material.button.MaterialButton
                            android:id="@+id/range3m"
                            style="@style/Widget.Lifting.SegmentButton"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:text="3M" />

                        <com.google.android.material.button.MaterialButton
                            android:id="@+id/range6m"
                            style="@style/Widget.Lifting.SegmentButton"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:text="6M" />

                        <com.google.android.material.button.MaterialButton
                            android:id="@+id/range1y"
                            style="@style/Widget.Lifting.SegmentButton"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:text="1Y" />

                        <com.google.android.material.button.MaterialButton
                            android:id="@+id/rangeAll"
                            style="@style/Widget.Lifting.SegmentButton"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:text="All" />
                    </com.google.android.material.button.MaterialButtonToggleGroup>

                    <!-- Shown after a point on the chart is tapped; opens LogTab.delLog() for that day's sets.
                         Sits below the range buttons so nothing above it moves when it appears. -->
                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/editSetButton"
                        style="@style/Widget.Material3.Button.TonalButton"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="10dp"
                        android:text="Edit or delete set"
                        android:visibility="gone"
                        app:icon="@drawable/ic_edit"
                        app:iconGravity="textStart"
                        app:iconSize="18dp" />
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <TextView
                android:id="@+id/lastSavedText"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                android:textAppearance="@style/TextAppearance.Lifting.Muted" />

            <!-- Workout log: workouts logged from the Workouts tab, newest first, grouped by month -->
            <com.google.android.material.card.MaterialCardView
                android:id="@+id/workoutLogCard"
                style="@style/Widget.Lifting.Card"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                app:cardCornerRadius="24dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:paddingStart="16dp"
                    android:paddingTop="14dp"
                    android:paddingEnd="16dp"
                    android:paddingBottom="10dp">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:gravity="center_vertical"
                        android:orientation="horizontal">

                        <LinearLayout
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:orientation="vertical">

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="Workout log"
                                android:textAppearance="@style/TextAppearance.Lifting.RowTitle" />

                            <TextView
                                android:id="@+id/workoutLogSummary"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:textAppearance="@style/TextAppearance.Lifting.Caption" />
                        </LinearLayout>

                        <com.google.android.material.button.MaterialButton
                            android:id="@+id/logWorkoutButton"
                            style="@style/Widget.Material3.Button.TonalButton"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Log workout"
                            app:icon="@drawable/ic_checklist"
                            app:iconSize="18dp" />
                    </LinearLayout>

                    <LinearLayout
                        android:id="@+id/workoutLogControls"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="10dp"
                        android:gravity="center_vertical"
                        android:orientation="horizontal">

                        <com.google.android.material.button.MaterialButtonToggleGroup
                            android:id="@+id/logFilterToggle"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            app:selectionRequired="true"
                            app:singleSelection="true">

                            <com.google.android.material.button.MaterialButton
                                android:id="@+id/logFilterAll"
                                style="@style/Widget.Lifting.SegmentButton"
                                android:layout_width="0dp"
                                android:layout_height="wrap_content"
                                android:layout_weight="1"
                                android:text="All" />

                            <com.google.android.material.button.MaterialButton
                                android:id="@+id/logFilterOpen"
                                style="@style/Widget.Lifting.SegmentButton"
                                android:layout_width="0dp"
                                android:layout_height="wrap_content"
                                android:layout_weight="1.3"
                                android:text="To finish" />

                            <com.google.android.material.button.MaterialButton
                                android:id="@+id/logFilterDone"
                                style="@style/Widget.Lifting.SegmentButton"
                                android:layout_width="0dp"
                                android:layout_height="wrap_content"
                                android:layout_weight="1"
                                android:text="Done" />
                        </com.google.android.material.button.MaterialButtonToggleGroup>

                        <!-- Newest first / Oldest first -->
                        <com.google.android.material.button.MaterialButton
                            android:id="@+id/logSortButton"
                            style="@style/Widget.Material3.Button.TextButton"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginStart="4dp"
                            android:minWidth="0dp"
                            android:paddingStart="8dp"
                            android:paddingEnd="8dp"
                            app:icon="@drawable/ic_sort"
                            app:iconSize="18dp" />
                    </LinearLayout>

                    <!-- Month headings (item_log_month) and log rows (item_session), filled by LogTab -->
                    <LinearLayout
                        android:id="@+id/workoutLogList"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="4dp"
                        android:orientation="vertical" />

                    <TextView
                        android:id="@+id/workoutLogEmpty"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:paddingTop="12dp"
                        android:paddingBottom="8dp"
                        android:textAppearance="@style/TextAppearance.Lifting.Muted"
                        android:visibility="gone" />

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/showMoreButton"
                        style="@style/Widget.Material3.Button.TextButton"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_gravity="center_horizontal"
                        android:text="Show more"
                        android:visibility="gone" />
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>
        </LinearLayout>
    </androidx.core.widget.NestedScrollView>

    <com.google.android.material.floatingactionbutton.ExtendedFloatingActionButton
        android:id="@+id/addWeightFab"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="bottom|end"
        android:layout_margin="16dp"
        android:contentDescription="Log a set"
        android:text="Log set"
        android:textColor="?attr/colorOnPrimary"
        app:backgroundTint="?attr/colorPrimary"
        app:icon="@drawable/ic_add"
        app:iconTint="?attr/colorOnPrimary" />
</FrameLayout>
