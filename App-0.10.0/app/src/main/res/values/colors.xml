<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- ============================================================
         Two palettes: dark mode (bg_) and light mode (dl_), one per theme in themes.xml.
         Layouts never use these directly: they use theme attributes
         (?attr/colorPrimary, ?attr/colorOnSurface, ...) so every screen
         re-colors when the theme changes.
         ============================================================ -->

