    <color name="bg_secondary_container">#FF28467A</color>
    <color name="bg_on_secondary_container">#FFE0EAFA</color>
    <color name="bg_surface">#FF0E2244</color>
    <color name="bg_on_surface">#FFF2F4F8</color>
    <color name="bg_on_surface_variant">#FFA9B7CF</color>
