<?xml version="1.0" encoding="utf-8"?>
<!-- Garrett's project4 screen (exerciseSpinner + liftChart + addWeightFab, same ids),
     with an athlete picker above the chart. The chart now sits in a card with a
     best-max summary and a time-range selector underneath. -->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <androidx.core.widget.NestedScrollView
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:clipToPadding="false"
        android:paddingBottom="96dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="16dp">

            <TextView
                android:id="@+id/athleteLabel"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginBottom="6dp"
                android:text="Athlete"
                android:textAppearance="@style/TextAppearance.Lifting.FieldLabel" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <FrameLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1">

                    <Spinner
                        android:id="@+id/athleteSpinner"
                        style="@style/Widget.Lifting.Spinner"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content" />

                    <TextView
                        android:id="@+id/noAthletesText"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_gravity="center_vertical"
                        android:text="No athletes yet. Add one to start logging."
                        android:textAppearance="@style/TextAppearance.Lifting.Muted"
                        android:visibility="gone" />
                </FrameLayout>

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/addAthleteButton"
                    style="@style/Widget.Material3.Button.TonalButton"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="10dp"
                    android:minHeight="52dp"
                    android:insetTop="0dp"
                    android:insetBottom="0dp"
                    android:text="Add athlete"
                    app:icon="@drawable/ic_person_add"
                    app:iconSize="18dp" />
            </LinearLayout>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="14dp"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <Spinner
                    android:id="@+id/exerciseSpinner"
                    style="@style/Widget.Lifting.Spinner"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1" />

                <TextView
                    android:id="@+id/chartCaption"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="16dp"
                    android:layout_marginEnd="4dp"
                    android:textAppearance="@style/TextAppearance.Lifting.Muted" />
            </LinearLayout>

            <!-- Progress card: best max + change, chart, range selector -->
            <com.google.android.material.card.MaterialCardView
                android:id="@+id/chartContainer"
                style="@style/Widget.Lifting.Card"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="14dp"
                app:cardCornerRadius="24dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:paddingStart="16dp"
                    android:paddingTop="16dp"
                    android:paddingEnd="16dp"
                    android:paddingBottom="14dp">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal">

                        <LinearLayout
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:orientation="vertical">

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="Best est. max"
                                android:textAppearance="@style/TextAppearance.Lifting.FieldLabel" />

                            <TextView
                                android:id="@+id/bestMaxText"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="—"
                                android:textAppearance="@style/TextAppearance.Lifting.Stat" />
                        </LinearLayout>

                        <LinearLayout
                            android:id="@+id/changeGroup"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:gravity="end"
                            android:orientation="vertical"
                            android:visibility="invisible">

                            <TextView
                                android:id="@+id/changeLabel"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:textAppearance="@style/TextAppearance.Lifting.FieldLabel" />

                            <TextView
                                android:id="@+id/changeText"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_marginTop="6dp"
                                android:textAppearance="@style/TextAppearance.Lifting.StatSmall" />
                        </LinearLayout>
                    </LinearLayout>

                    <com.github.mikephil.charting.charts.LineChart
                        android:id="@+id/liftChart"
                        android:layout_width="match_parent"
                        android:layout_height="300dp"
                        android:layout_marginTop="8dp" />

                    <com.google.android.material.button.MaterialButtonToggleGroup
                        android:id="@+id/rangeToggle"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="12dp"
                        app:selectionRequired="true"
                        app:singleSelection="true">

                        <com.google.android.material.button.MaterialButton
                            android:id="@+id/range1m"
                            style="@style/Widget.Lifting.SegmentButton"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:text="1M" />

                        <com.google.android.material.button.MaterialButton
                            android:id="@+id/range3m"
                            style="@style/Widget.Lifting.SegmentButton"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:text="3M" />

                        <com.google.android.material.button.MaterialButton
                            android:id="@+id/range6m"
                            style="@style/Widget.Lifting.SegmentButton"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:text="6M" />

                        <com.google.android.material.button.MaterialButton
                            android:id="@+id/range1y"
                            style="@style/Widget.Lifting.SegmentButton"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:text="1Y" />

                        <com.google.android.material.button.MaterialButton
                            android:id="@+id/rangeAll"
                            style="@style/Widget.Lifting.SegmentButton"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:text="All" />
                    </com.google.android.material.button.MaterialButtonToggleGroup>

                    <!-- Shown after a point on the chart is tapped; opens LogTab.delLog() for that day's sets.
                         Sits below the range buttons so nothing above it moves when it appears. -->
                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/editSetButton"
                        style="@style/Widget.Material3.Button.TonalButton"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="10dp"
                        android:text="Edit or delete set"
                        android:visibility="gone"
                        app:icon="@drawable/ic_edit"
                        app:iconGravity="textStart"
                        app:iconSize="18dp" />
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <TextView
                android:id="@+id/lastSavedText"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="14dp"
                android:textAppearance="@style/TextAppearance.Lifting.Muted" />
        </LinearLayout>
    </androidx.core.widget.NestedScrollView>

    <com.google.android.material.floatingactionbutton.ExtendedFloatingActionButton
        android:id="@+id/addWeightFab"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="bottom|end"
        android:layout_margin="16dp"
        android:contentDescription="Log a set"
        android:text="Log set"
        android:textColor="?attr/colorOnPrimary"
        app:backgroundTint="?attr/colorPrimary"
        app:icon="@drawable/ic_add"
        app:iconTint="?attr/colorOnPrimary" />
</FrameLayout>
