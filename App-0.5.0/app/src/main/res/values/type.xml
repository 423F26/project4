<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- ============================================================
         Typography: Poppins (res/font) in three weights.
         The M3 type-scale attributes in themes.xml point here, so buttons,
         tabs, dialogs and text fields all pick up Poppins automatically.
         Each style sets both android:fontFamily and fontFamily so the font
         also loads on Android 7 (minSdk 24) through AppCompat.
         ============================================================ -->

    <!-- M3 type scale -->
    <style name="TextAppearance.Lifting.HeadlineSmall" parent="TextAppearance.Material3.HeadlineSmall">
        <item name="android:fontFamily">@font/poppins_bold</item>
        <item name="fontFamily">@font/poppins_bold</item>
        <item name="android:textSize">22sp</item>
        <item name="android:letterSpacing">0</item>
    </style>
    <style name="TextAppearance.Lifting.TitleLarge" parent="TextAppearance.Material3.TitleLarge">
        <item name="android:fontFamily">@font/poppins_bold</item>
        <item name="fontFamily">@font/poppins_bold</item>
        <item name="android:textSize">20sp</item>
        <item name="android:letterSpacing">0</item>
    </style>
    <style name="TextAppearance.Lifting.TitleMedium" parent="TextAppearance.Material3.TitleMedium">
        <item name="android:fontFamily">@font/poppins_medium</item>
        <item name="fontFamily">@font/poppins_medium</item>
        <item name="android:textSize">16sp</item>
        <item name="android:letterSpacing">0</item>
    </style>
    <style name="TextAppearance.Lifting.TitleSmall" parent="TextAppearance.Material3.TitleSmall">
        <item name="android:fontFamily">@font/poppins_medium</item>
        <item name="fontFamily">@font/poppins_medium</item>
        <item name="android:textSize">14sp</item>
        <item name="android:letterSpacing">0</item>
    </style>
    <style name="TextAppearance.Lifting.BodyLarge" parent="TextAppearance.Material3.BodyLarge">
        <item name="android:fontFamily">@font/poppins_regular</item>
        <item name="fontFamily">@font/poppins_regular</item>
        <item name="android:textSize">16sp</item>
        <item name="android:letterSpacing">0</item>
    </style>
    <style name="TextAppearance.Lifting.BodyMedium" parent="TextAppearance.Material3.BodyMedium">
        <item name="android:fontFamily">@font/poppins_regular</item>
        <item name="fontFamily">@font/poppins_regular</item>
        <item name="android:textSize">14sp</item>
        <item name="android:letterSpacing">0</item>
    </style>
    <style name="TextAppearance.Lifting.BodySmall" parent="TextAppearance.Material3.BodySmall">
        <item name="android:fontFamily">@font/poppins_regular</item>
        <item name="fontFamily">@font/poppins_regular</item>
        <item name="android:textSize">12sp</item>
        <item name="android:letterSpacing">0</item>
    </style>
    <style name="TextAppearance.Lifting.LabelLarge" parent="TextAppearance.Material3.LabelLarge">
        <item name="android:fontFamily">@font/poppins_medium</item>
        <item name="fontFamily">@font/poppins_medium</item>
        <item name="android:textSize">14sp</item>
        <item name="android:letterSpacing">0.01</item>
        <item name="android:textAllCaps">false</item>
    </style>
    <style name="TextAppearance.Lifting.LabelMedium" parent="TextAppearance.Material3.LabelMedium">
        <item name="android:fontFamily">@font/poppins_medium</item>
        <item name="fontFamily">@font/poppins_medium</item>
        <item name="android:textSize">12sp</item>
        <item name="android:letterSpacing">0.01</item>
    </style>
    <style name="TextAppearance.Lifting.LabelSmall" parent="TextAppearance.Material3.LabelSmall">
        <item name="android:fontFamily">@font/poppins_medium</item>
        <item name="fontFamily">@font/poppins_medium</item>
        <item name="android:textSize">11sp</item>
        <item name="android:letterSpacing">0.01</item>
    </style>

    <!-- App-specific roles (color included, so layouts only set textAppearance) -->
    <style name="TextAppearance.Lifting.AppTitle" parent="TextAppearance.Lifting.TitleLarge">
        <item name="android:textSize">21sp</item>
        <item name="android:letterSpacing">0.02</item>
        <item name="android:textColor">?attr/colorOnSurface</item>
    </style>
    <style name="TextAppearance.Lifting.Tab" parent="TextAppearance.Lifting.TitleSmall">
        <item name="android:textAllCaps">false</item>
    </style>
    <style name="TextAppearance.Lifting.FieldLabel" parent="TextAppearance.Lifting.LabelMedium">
        <item name="android:textColor">?attr/colorOnSurfaceVariant</item>
    </style>
    <style name="TextAppearance.Lifting.Body" parent="TextAppearance.Lifting.BodyMedium">
        <item name="android:textColor">?attr/colorOnSurface</item>
    </style>
    <style name="TextAppearance.Lifting.Muted" parent="TextAppearance.Lifting.BodyMedium">
        <item name="android:textColor">?attr/colorOnSurfaceVariant</item>
    </style>
    <style name="TextAppearance.Lifting.Caption" parent="TextAppearance.Lifting.BodySmall">
        <item name="android:textColor">?attr/colorOnSurfaceVariant</item>
    </style>
    <style name="TextAppearance.Lifting.RowTitle" parent="TextAppearance.Lifting.TitleMedium">
        <item name="android:textColor">?attr/colorOnSurface</item>
    </style>
    <!-- The big "best est. max" number on the Log tab -->
    <style name="TextAppearance.Lifting.Stat" parent="TextAppearance.Lifting.HeadlineSmall">
        <item name="android:textSize">30sp</item>
        <item name="android:letterSpacing">-0.01</item>
        <item name="android:textColor">?attr/colorOnSurface</item>
    </style>
    <style name="TextAppearance.Lifting.StatSmall" parent="TextAppearance.Lifting.TitleLarge">
        <item name="android:textSize">20sp</item>
        <item name="android:textColor">?attr/colorOnSurface</item>
    </style>
    <!-- Right-aligned numbers in History / Leaderboard rows -->
    <style name="TextAppearance.Lifting.RowValue" parent="TextAppearance.Lifting.TitleLarge">
        <item name="android:textSize">18sp</item>
        <item name="android:textColor">?attr/colorPrimary</item>
    </style>
    <style name="TextAppearance.Lifting.Rank" parent="TextAppearance.Lifting.TitleLarge">
        <item name="android:textSize">15sp</item>
    </style>
</resources>
